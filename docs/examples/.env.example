# Example Environment Variables for Local Testing
# DO NOT commit actual credentials to git!
# Copy this file to .env for local development testing

# Email Configuration
# These should match your GitHub Secrets for consistency

# EMAIL_USERNAME: The email address that will send notifications
# Examples:
#   - Gmail: your.email@gmail.com
#   - Outlook: your.email@outlook.com
#   - Corporate: your.email@company.com
EMAIL_USERNAME=your.email@example.com

# EMAIL_PASSWORD: App password (NOT your regular password!)
# Generate app passwords:
#   - Gmail: https://myaccount.google.com/apppasswords
#   - Outlook: https://account.microsoft.com/security
#   - Corporate: Contact IT department
EMAIL_PASSWORD=your-app-password-here

# EMAIL_TO: Recipient email address(es)
# Multiple recipients: separate with commas (no spaces)
# Examples:
#   - Single: admin@example.com
#   - Multiple: admin@example.com,team@example.com,alerts@example.com
EMAIL_TO=recipient@example.com

# Optional: SMTP Server Configuration
# Usually auto-detected from EMAIL_USERNAME domain
# Uncomment and configure if using custom SMTP server

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true

# Development vs Production
# Use different values for different environments

# Development (your personal email)
# EMAIL_USERNAME=your.personal@gmail.com
# EMAIL_PASSWORD=your-personal-app-password
# EMAIL_TO=your.personal@gmail.com

# Staging (limited team)
# EMAIL_USERNAME=monitoring@company.com
# EMAIL_PASSWORD=staging-app-password
# EMAIL_TO=you@company.com,lead@company.com

# Production (full team)
# EMAIL_USERNAME=monitoring@ancoris.com
# EMAIL_PASSWORD=production-app-password
# EMAIL_TO=team@ancoris.com,it@ancoris.com

# IMPORTANT SECURITY NOTES:
# 1. Never commit this file with real credentials to git
# 2. Add .env to .gitignore
# 3. Use app passwords, not regular passwords
# 4. Enable 2-factor authentication on email accounts
# 5. Store production credentials in GitHub Secrets
# 6. Store backup credentials in team password manager
